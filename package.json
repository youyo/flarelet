{
  "name": "flarelet",
  "version": "0.3.0",
  "description": "Serverless application platform for AWS: declare what your app needs in YAML, push, and Flarelet handles infrastructure, auth, previews and deployment.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youyo/flarelet.git"
  },
  "homepage": "https://github.com/youyo/flarelet#readme",
  "bugs": {
    "url": "https://github.com/youyo/flarelet/issues"
  },
  "keywords": [
    "aws",
    "serverless",
    "lambda",
    "cdk",
    "cli",
    "preview-environments",
    "github-actions",
    "deploy"
  ],
  "bin": {
    "flarelet": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    ".agents/skills",
    "LICENSE",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-cdk/toolkit-lib": "^1.42.1",
    "@aws-sdk/client-cloudformation": "^3.1144.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1144.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1144.0",
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/client-iam": "^3.1144.0",
    "@aws-sdk/client-lambda": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/client-secrets-manager": "^3.1144.0",
    "@aws-sdk/client-ssm": "^3.1144.0",
    "@aws-sdk/client-sts": "^3.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "commander": "^15.0.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-ecr": "^3.1144.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
